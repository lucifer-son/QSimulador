# Copie para .env (nunca versione o .env) ou defina estas variáveis no ambiente.
# Todas são opcionais: sem QSIMULADOR_DATABASE_URL a API funciona normalmente, só sem o histórico.

# URL do PostgreSQL. Também é aceita DATABASE_URL (é o nome que Neon e Vercel costumam criar).
# QSIMULADOR_DATABASE_URL=postgresql://usuario:senha@localhost:5432/qsimulador

# Origens do frontend liberadas no CORS (separadas por vírgula), quando front e API ficam em domínios diferentes.
# QSIMULADOR_CORS_ORIGINS=https://meu-app.vercel.app

# Limites do histórico (valores padrão abaixo).
# QSIMULADOR_MAX_RECORD_BYTES=2000000
# QSIMULADOR_MAX_RECORDS_PER_CLIENT=200
