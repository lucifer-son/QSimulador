          "Wq"
        ],
        "title": "MM1CalculateResponse"
      },
      "MM1CompareRequest": {
        "properties": {
          "lambda": {
            "type": "number",
            "title": "Lambda",
            "description": "Taxa média de chegada (λ)."
          },
          "mu": {
            "type": "number",
            "title": "Mu",
            "description": "Taxa média de serviço (μ)."
          },
          "simulation_time": {
            "type": "number",
            "title": "Simulation Time",
            "description": "Tempo simulado por replicação."
          },
          "replications": {
            "type": "integer",
            "title": "Replications",
            "description": "Número de replicações.",
            "default": 10
          },
          "warmup_time": {
            "type": "number",
            "title": "Warmup Time",
            "description": "Período inicial descartado (transitório).",
