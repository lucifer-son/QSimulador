        ]
      },
      "MM1CalculateResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "M/M/1"
          },
          "rho": {
            "type": "number",
            "title": "Rho"
          },
          "L": {
            "type": "number",
            "title": "L"
          },
          "Lq": {
            "type": "number",
            "title": "Lq"
          },
          "W": {
            "type": "number",
            "title": "W"
