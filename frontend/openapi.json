  "components": {
    "schemas": {
      "ComparisonResponse": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "M/M/1"
          },
          "lambda": {
            "type": "number",
            "title": "Lambda"
          },
          "mu": {
            "type": "number",
            "title": "Mu"
          },
          "simulation_time": {
            "type": "number",
            "title": "Simulation Time"
          },
          "warmup_time": {
            "type": "number",
            "title": "Warmup Time"
          },
          "replications": {
            "type": "integer",
            "title": "Replications"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "confidence_level": {
            "type": "number",
            "title": "Confidence Level"
          },
          "metrics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/MetricComparisonOut"
            },
            "type": "object",
            "title": "Metrics"
          },
          "all_within_ci": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "All Within Ci"
          },
          "max_relative_error_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Relative Error Pct"
          }
        },
        "type": "object",
        "required": [
          "lambda",
          "mu",
          "simulation_time",
          "warmup_time",
          "replications",
          "seed",
          "confidence_level",
          "metrics",
          "all_within_ci",
          "max_relative_error_pct"
        ],
        "title": "ComparisonResponse"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "MM1CalculateRequest": {
        "properties": {
          "lambda": {
            "type": "number",
            "title": "Lambda",
            "description": "Taxa média de chegada (λ)."
          },
          "mu": {
            "type": "number",
            "title": "Mu",
            "description": "Taxa média de serviço (μ)."
          }
        },
        "type": "object",
        "required": [
          "lambda",
          "mu"
        ],
        "title": "MM1CalculateRequest",
        "examples": [
